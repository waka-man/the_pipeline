# Copy this file to `.env` next to compose.yaml and fill in what you need.
# Docker Compose reads it automatically. Nothing here is required: the
# container starts without it, and free models work without a key.

# Where the installed app keeps its data. This is the directory the container
# shares, so a session started in one version is there in the other.
#
#   Linux    ~/.config/Grading Pipeline
#   macOS    ~/Library/Application Support/Grading Pipeline
#   Windows  AppData\Roaming\Grading Pipeline
#GRADING_PIPELINE_HOST_DATA=~/.config/Grading Pipeline

# Where the collected submissions and the rendered reports are written. It
# has to be the same absolute path in both versions, because the database
# records it.
#GRADING_PIPELINE_HOST_WORKSPACE=~/grading-pipeline-workspace

# Your own opencode: the store with the accounts you signed into, and the
# configuration beside it. On Linux they are
#   ~/.local/share/opencode  and  ~/.config/opencode
# and on macOS both are
#   ~/Library/Application Support/opencode
#GRADING_PIPELINE_HOST_OPENCODE=~/.local/share/opencode
#GRADING_PIPELINE_HOST_OPENCODE_CONFIG=~/.config/opencode

# Canvas credentials. The Setup step in the browser saves them too, but a
# token the installed app keeps in the OS keychain cannot be read from a
# container: put it here.
#GRADING_PIPELINE_CANVAS_BASE_URL=https://school.instructure.com
#GRADING_PIPELINE_CANVAS_API_TOKEN=

# Optional. The free models work without a key.
#OPENROUTER_API_KEY=
